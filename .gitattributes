# gofmt, GNU make, patch and bash all expect LF in the working tree.
# core.autocrlf on Windows would otherwise check these out as CRLF.
*.go      text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.s       text eol=lf
Makefile  text eol=lf
*.mk      text eol=lf
*.patch   text eol=lf
*.sh      text eol=lf
