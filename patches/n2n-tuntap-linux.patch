+/* Applies an address that arrives after tuntap_open(), i.e. SN_ASSIGN. */
+int tuntap_configure_address (struct tuntap_dev *device, const char *ip,
+                              const char *mask, int mtu) {
+
+    struct ifreq ifr;
+    int fd;
+
+    if((device == NULL) || (ip == NULL) || (ip[0] == '\0'))
+        return -1;
+
+    if((fd = socket(PF_INET, SOCK_DGRAM, IPPROTO_IP)) < 0) {
+        traceEvent(TRACE_ERROR, "socket creation failed [%d]: %s", errno, strerror(errno));
+        return -1;
+    }
+
+    memset(&ifr, 0, sizeof(ifr));
+    strncpy(ifr.ifr_name, device->dev_name, IFNAMSIZ);
+    ifr.ifr_name[IFNAMSIZ-1] = '\0';
+    ifr.ifr_addr.sa_family = AF_INET;
+
+    inet_pton(AF_INET, ip, &((struct sockaddr_in*)&ifr.ifr_addr)->sin_addr);
+    if(ioctl(fd, SIOCSIFADDR, &ifr) == -1) {
+        traceEvent(TRACE_ERROR, "ioctl(SIOCSIFADDR, %s) failed [%d]: %s", ip, errno, strerror(errno));
+        close(fd);
+        return -2;
+    }
+
+    if(mask && mask[0] != '\0') {
+        inet_pton(AF_INET, mask, &((struct sockaddr_in*)&ifr.ifr_addr)->sin_addr);
+        if(ioctl(fd, SIOCSIFNETMASK, &ifr) == -1) {
+            traceEvent(TRACE_ERROR, "ioctl(SIOCSIFNETMASK, %s) failed [%d]: %s", mask, errno, strerror(errno));
+            close(fd);
+            return -3;
+        }
+    }
+
+    if(mtu > 0) {
+        ifr.ifr_mtu = mtu;
+        if(ioctl(fd, SIOCSIFMTU, &ifr) == -1) {
+            traceEvent(TRACE_ERROR, "ioctl(SIOCSIFMTU, %d) failed [%d]: %s", mtu, errno, strerror(errno));
+            close(fd);
+            return -4;
+        }
+    }
+
+    close(fd);
+
+    device->ip_addr = inet_addr(ip);
+    device->device_mask = (mask && mask[0] != '\0') ? inet_addr(mask) : 0;
+    device->mtu = (uint16_t)mtu;
+
+    return 0;
+}
